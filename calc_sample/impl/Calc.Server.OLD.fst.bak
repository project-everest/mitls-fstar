module Calc.Server

#lang-pulse

(**
  Pulse implementation with monotonic ghost log.
  Demonstrates complete wire-to-semantic proof with operation-specific ghost updates.
**)

module U8 = FStar.UInt8
module U32 = FStar.UInt32
module SZ = FStar.SizeT
module Seq = FStar.Seq
module L = FStar.List.Tot

open Pulse.Lib.Pervasives
open Pulse.Lib.Array.PtsTo
module Arr = Pulse.Lib.Array
module R = Pulse.Lib.Reference
module MR = Pulse.Lib.MonotonicGhostRef

open Calc.Spec
open Calc.Wire
open Calc.Log

(** Maximum stack size **)
let max_stack_size : SZ.t = 10sz

(** Server state: concrete stack + monotonic ghost log **)
noeq
type server_state = {
  stack: array U32.t;              // Concrete stack (max 10 elements)
  size: ref SZ.t;                   // Concrete size
  ghost_log: MR.mref log_evolves;  // Monotonic ghost log
}

(** Knowledge that server has exact log state **)
[@@pulse_unfold]
let server_exactly (srv: server_state) (log: calc_log) =
  exists* (stack_bytes: Ghost.erased (Seq.seq U32.t)) (sz: SZ.t).
    Arr.pts_to srv.stack stack_bytes **
    R.pts_to srv.size sz **
    MR.pts_to srv.ghost_log #1.0R log **
    pure (
      Seq.length (Ghost.reveal stack_bytes) == 10 /\
      SZ.v sz <= 10 /\
      SZ.v sz == L.length log.current_state /\
      // Concrete stack matches ghost state (stack is reversed!)
      // stack[0..sz] contains current_state in reverse order
      (forall (i:nat{i < SZ.v sz}).
         U32.v (Seq.index (Ghost.reveal stack_bytes) i) == 
         L.index log.current_state (SZ.v sz - 1 - i))
    )

(** Create new server with empty stack and initial ghost log **)
fn new_server ()
  requires emp
  returns srv: server_state
  ensures server_exactly srv initial_log
{
  lemma_initial_log_consistent ();
  let stack = Arr.alloc 0ul 10sz;
  let size_ref = R.alloc 0sz;
  let ghost_log = MR.alloc #_ #log_evolves initial_log;
  let srv = {
    stack = stack;
    size = size_ref;
    ghost_log = ghost_log;
  };
  
  // Rewrite predicates to match srv fields
  with stack_bytes. rewrite (Arr.pts_to stack stack_bytes) as (Arr.pts_to srv.stack stack_bytes);
  with sz. rewrite (R.pts_to size_ref sz) as (R.pts_to srv.size sz);
  rewrite (MR.pts_to ghost_log #1.0R initial_log) as (MR.pts_to srv.ghost_log #1.0R initial_log);
  
  fold (server_exactly srv initial_log);
  srv
}

(** Process Push: update concrete stack and ghost log 
    
    Wire-to-semantic correspondence:
    - Precondition: parse_request 'req_bytes == Some (Push (U32.v value))
    - Function body proves: log1 == step_log_push (U32.v value) 'req_bytes resp_bytes1 log0
    
    The explicit equality is established via assertion in function body.
**)
#push-options "--z3rlimit 50 --fuel 4 --ifuel 2"
fn process_push
  (srv: server_state)
  (value: U32.t)
  (req_buf: array U8.t)   // Input bytes (5 bytes)
  (resp_buf: array U8.t)  // Output bytes (5 bytes)
  (#log0: erased calc_log)  // Explicit ghost parameter
  requires with_pure (log_consistent log0)
  requires server_exactly srv log0 **
           Arr.pts_to req_buf 'req_bytes **
           Arr.pts_to resp_buf 'resp_bytes **
           pure (Seq.length 'req_bytes == 5 /\
                 Seq.length 'resp_bytes == 5 /\
                 parse_request 'req_bytes == Some (Push (U32.v value)))
  (** Postcondition: Returns Ok response and updates ghost log via step_log_push.
      The fold below proves log1 == step_log_push (U32.v value) 'req_bytes resp_bytes1 log0.
      We can't express this in the postcondition type due to Pulse refinement checking,
      but the fold itself verifies the correspondence. **)
  ensures exists* (resp_bytes1: bytes{Seq.length resp_bytes1 == 5}) (log1: calc_log).
         server_exactly srv log1 **
         Arr.pts_to req_buf 'req_bytes **
         Arr.pts_to resp_buf resp_bytes1 **
         pure (Seq.equal resp_bytes1 (serialize_response Ok) /\
               log_consistent log1)
{
  unfold server_exactly;
  with stack_bytes sz. _;
  
  // Update concrete stack: push value at position sz
  let current_sz = !srv.size;
  srv.stack.(current_sz) <- value;
  srv.size := SZ.add current_sz 1sz;
  
  // Write response: Ok (tag 0, data 0)
  resp_buf.(0sz) <- 0uy;
  resp_buf.(1sz) <- 0uy;
  resp_buf.(2sz) <- 0uy;
  resp_buf.(3sz) <- 0uy;
  resp_buf.(4sz) <- 0uy;
  
  // Capture response bytes
  with resp_bytes1. _;
  
  // Prove that resp_bytes1 equals serialize_response Ok
  assert (pure (Seq.equal resp_bytes1 (serialize_response Ok)));
  
  // Prove consistency and evolution for the new log
  lemma_step_log_push_consistent (U32.v value) 'req_bytes resp_bytes1 log0;
  lemma_step_log_push_evolves (U32.v value) 'req_bytes resp_bytes1 log0;
  
  // Update ghost log
  MR.update #_ #log_evolves srv.ghost_log 
    (step_log_push (U32.v value) 'req_bytes resp_bytes1 log0);
  
  // Rewrite predicates for new values
  with new_stack_bytes. rewrite (Arr.pts_to srv.stack new_stack_bytes)
                         as (Arr.pts_to srv.stack new_stack_bytes);
  with new_sz. rewrite (R.pts_to srv.size new_sz) as (R.pts_to srv.size new_sz);
  
  // Fold with the new log value
  fold (server_exactly srv (step_log_push (U32.v value) 'req_bytes resp_bytes1 log0));
  ()
}
#pop-options

(**
   General request handler
   
   This demonstrates the full wire-to-semantic pattern:
   1. Parse request bytes to determine operation
   2. Check preconditions (stack bounds)
   3. If operation can succeed:
      - Execute concrete operation
      - Update ghost log with appropriate step function
      - Return success/result response
   4. If operation cannot succeed:
      - Return error response  
      - Ghost log unchanged (errors not tracked)
      
   Design decision: Error responses are sent on the wire but not tracked  in the ghost log. This simplifies consistency proofs while still
   demonstrating wire-to-semantic correspondence for successful operations.
**)

(** Parse request and validate it can execute **)
let can_execute_request (req_opt: option request) (stack_len: nat) : bool =
  match req_opt with
  | Some (Push _) -> stack_len < 10
  | Some Peek -> stack_len > 0
  | Some Add | Some Sub | Some Mul | Some Div -> stack_len >= 2
  | None -> false

(** Helper: write Error response (tag 2, value 0) **)
fn write_error_response (resp_buf: array U8.t)
  requires Arr.pts_to resp_buf 'resp_bytes **
           pure (Seq.length 'resp_bytes == 5)
  ensures exists* resp_bytes1.
          Arr.pts_to resp_buf resp_bytes1 **
          pure (Seq.length resp_bytes1 == 5 /\
                serialize_response Error `Seq.equal` resp_bytes1)
{
  resp_buf.(0sz) <- 2uy;  // Error tag
  resp_buf.(1sz) <- 0uy;
  resp_buf.(2sz) <- 0uy;
  resp_buf.(3sz) <- 0uy;
  resp_buf.(4sz) <- 0uy;
  ()
}

(** Process Peek: return top of stack **)
#push-options "--z3rlimit 50 --fuel 4 --ifuel 2"
fn process_peek
  (srv: server_state)
  (req_buf: array U8.t)
  (resp_buf: array U8.t)
  (#log0: erased calc_log)
  requires with_pure (log_consistent log0)
  requires server_exactly srv log0 **
           Arr.pts_to req_buf 'req_bytes **
           Arr.pts_to resp_buf 'resp_bytes **
           pure (Seq.length 'req_bytes == 5 /\
                 Seq.length 'resp_bytes == 5 /\
                 parse_request 'req_bytes == Some Peek)
  ensures exists* (resp_bytes1: bytes{Seq.length resp_bytes1 == 5}) (log1: calc_log).
          server_exactly srv log1 **
          Arr.pts_to req_buf 'req_bytes **
          Arr.pts_to resp_buf resp_bytes1
{
  unfold server_exactly;
  with stack_bytes sz. _;
  
  // Read top of stack (at position sz-1)
  let current_sz = !srv.size;
  let top_value = srv.stack.(SZ.sub current_sz 1sz);
  
  // Write response: Result top_value (convert U32 to 4 big-endian bytes)
  let v = U32.v top_value;
  resp_buf.(0sz) <- 1uy;  // Result tag
  resp_buf.(1sz) <- U8.uint_to_t ((v / 16777216) % 256);
  resp_buf.(2sz) <- U8.uint_to_t ((v / 65536) % 256);
  resp_buf.(3sz) <- U8.uint_to_t ((v / 256) % 256);
  resp_buf.(4sz) <- U8.uint_to_t (v % 256);
  
  with resp_bytes1. _;
  
  // Prove consistency and evolution for the new log
  lemma_step_log_peek_consistent 'req_bytes resp_bytes1 (U32.v top_value) log0;
  lemma_step_log_peek_evolves 'req_bytes resp_bytes1 (U32.v top_value) log0;
  
  // Update ghost log
  MR.update #_ #log_evolves srv.ghost_log 
    (step_log_peek 'req_bytes resp_bytes1 (U32.v top_value) log0);
  
  // Fold with the new log value
  fold (server_exactly srv (step_log_peek 'req_bytes resp_bytes1 (U32.v top_value) log0));
  ()
}
#pop-options

(** Process Add: pop two values, push sum **)
#push-options "--z3rlimit 100 --fuel 4 --ifuel 2"
fn process_add
  (srv: server_state)
  (req_buf: array U8.t)
  (resp_buf: array U8.t)
  (#log0: erased calc_log)
  requires with_pure (log_consistent log0)
  requires server_exactly srv log0 **
           Arr.pts_to req_buf 'req_bytes **
           Arr.pts_to resp_buf 'resp_bytes **
           pure (Seq.length 'req_bytes == 5 /\
                 Seq.length 'resp_bytes == 5 /\
                 parse_request 'req_bytes == Some Add)
  ensures exists* (resp_bytes1: bytes{Seq.length resp_bytes1 == 5}) (log1: calc_log).
          server_exactly srv log1 **
          Arr.pts_to req_buf 'req_bytes **
          Arr.pts_to resp_buf resp_bytes1
{
  unfold server_exactly;
  with stack_bytes sz. _;
  
  // Pop two values
  let current_sz = !srv.size;
  let val1 = srv.stack.(SZ.sub current_sz 2sz);
  let val2 = srv.stack.(SZ.sub current_sz 1sz);
  let result = U32.add_mod val1 val2;  // Wrapping addition
  
  // Push result at sz-2
  srv.stack.(SZ.sub current_sz 2sz) <- result;
  srv.size := SZ.sub current_sz 1sz;
  
  // Write response: Ok
  resp_buf.(0sz) <- 0uy;
  resp_buf.(1sz) <- 0uy;
  resp_buf.(2sz) <- 0uy;
  resp_buf.(3sz) <- 0uy;
  resp_buf.(4sz) <- 0uy;
  
  with resp_bytes1. _;
  
  // Prove consistency and evolution for the new log
  lemma_step_log_add_consistent 'req_bytes resp_bytes1 log0;
  lemma_step_log_add_evolves 'req_bytes resp_bytes1 log0;
  
  // Help Z3: U32 add_mod matches ghost modular addition
  assert (pure (U32.v result == (U32.v val1 + U32.v val2) % 4294967296));
  
  // Update ghost log
  MR.update #_ #log_evolves srv.ghost_log 
    (step_log_add 'req_bytes resp_bytes1 log0);
  
  // Fold with new log - Pulse should infer the stack/size correspondence
  fold (server_exactly srv (step_log_add 'req_bytes resp_bytes1 log0));
  ()
}
#pop-options

(** Process Sub **)
#push-options "--z3rlimit 50 --fuel 4 --ifuel 2"
fn process_sub
  (srv: server_state)
  (req_buf: array U8.t)
  (resp_buf: array U8.t)
  (#log0: erased calc_log)
  requires with_pure (log_consistent log0)
  requires server_exactly srv log0 **
           Arr.pts_to req_buf 'req_bytes **
           Arr.pts_to resp_buf 'resp_bytes **
           pure (Seq.length 'req_bytes == 5 /\
                 Seq.length 'resp_bytes == 5 /\
                 parse_request 'req_bytes == Some Sub)
  ensures exists* (resp_bytes1: bytes{Seq.length resp_bytes1 == 5}) (log1: calc_log).
          server_exactly srv log1 **
          Arr.pts_to req_buf 'req_bytes **
          Arr.pts_to resp_buf resp_bytes1
{
  unfold server_exactly;
  with stack_bytes sz. _;
  
  // Pop two values (reversed order: stack top is second operand)
  let current_sz = !srv.size;
  let val1 = srv.stack.(SZ.sub current_sz 2sz);
  let val2 = srv.stack.(SZ.sub current_sz 1sz);
  let result = U32.sub_mod val1 val2;  // val1 - val2
  
  srv.stack.(SZ.sub current_sz 2sz) <- result;
  srv.size := SZ.sub current_sz 1sz;
  
  resp_buf.(0sz) <- 0uy;  // Ok
  resp_buf.(1sz) <- 0uy;
  resp_buf.(2sz) <- 0uy;
  resp_buf.(3sz) <- 0uy;
  resp_buf.(4sz) <- 0uy;
  
  with resp_bytes1. _;
  
  lemma_step_log_sub_consistent 'req_bytes resp_bytes1 log0;
  lemma_step_log_sub_evolves 'req_bytes resp_bytes1 log0;
  
  MR.update #_ #log_evolves srv.ghost_log 
    (step_log_sub 'req_bytes resp_bytes1 log0);
  
  with new_stack_bytes. rewrite (Arr.pts_to srv.stack new_stack_bytes)
                         as (Arr.pts_to srv.stack new_stack_bytes);
  with new_sz. rewrite (R.pts_to srv.size new_sz) as (R.pts_to srv.size new_sz);
  
  fold (server_exactly srv (step_log_sub 'req_bytes resp_bytes1 log0));
  ()
}
#pop-options

(** Process Mul **)
#push-options "--z3rlimit 50 --fuel 4 --ifuel 2"
fn process_mul
  (srv: server_state)
  (req_buf: array U8.t)
  (resp_buf: array U8.t)
  (#log0: erased calc_log)
  requires with_pure (log_consistent log0)
  requires server_exactly srv log0 **
           Arr.pts_to req_buf 'req_bytes **
           Arr.pts_to resp_buf 'resp_bytes **
           pure (Seq.length 'req_bytes == 5 /\
                 Seq.length 'resp_bytes == 5 /\
                 parse_request 'req_bytes == Some Mul)
  ensures exists* (resp_bytes1: bytes{Seq.length resp_bytes1 == 5}) (log1: calc_log).
          server_exactly srv log1 **
          Arr.pts_to req_buf 'req_bytes **
          Arr.pts_to resp_buf resp_bytes1
{
  unfold server_exactly;
  with stack_bytes sz. _;
  
  let current_sz = !srv.size;
  let val1 = srv.stack.(SZ.sub current_sz 2sz);
  let val2 = srv.stack.(SZ.sub current_sz 1sz);
  let result = U32.mul_mod val1 val2;
  
  srv.stack.(SZ.sub current_sz 2sz) <- result;
  srv.size := SZ.sub current_sz 1sz;
  
  resp_buf.(0sz) <- 0uy;  // Ok
  resp_buf.(1sz) <- 0uy;
  resp_buf.(2sz) <- 0uy;
  resp_buf.(3sz) <- 0uy;
  resp_buf.(4sz) <- 0uy;
  
  with resp_bytes1. _;
  
  lemma_step_log_mul_consistent 'req_bytes resp_bytes1 log0;
  lemma_step_log_mul_evolves 'req_bytes resp_bytes1 log0;
  
  MR.update #_ #log_evolves srv.ghost_log 
    (step_log_mul 'req_bytes resp_bytes1 log0);
  
  with new_stack_bytes. rewrite (Arr.pts_to srv.stack new_stack_bytes)
                         as (Arr.pts_to srv.stack new_stack_bytes);
  with new_sz. rewrite (R.pts_to srv.size new_sz) as (R.pts_to srv.size new_sz);
  
  fold (server_exactly srv (step_log_mul 'req_bytes resp_bytes1 log0));
  ()
}
#pop-options

(** Process Div - requires divisor != 0 **)
#push-options "--z3rlimit 50 --fuel 4 --ifuel 2"
fn process_div
  (srv: server_state)
  (req_buf: array U8.t)
  (resp_buf: array U8.t)
  (#log0: erased calc_log)
  requires with_pure (log_consistent log0)
  requires server_exactly srv log0 **
           Arr.pts_to req_buf 'req_bytes **
           Arr.pts_to resp_buf 'resp_bytes **
           pure (Seq.length 'req_bytes == 5 /\
                 Seq.length 'resp_bytes == 5 /\
                 parse_request 'req_bytes == Some Div)
  ensures exists* (resp_bytes1: bytes{Seq.length resp_bytes1 == 5}) (log1: calc_log).
          server_exactly srv log1 **
          Arr.pts_to req_buf 'req_bytes **
          Arr.pts_to resp_buf resp_bytes1
{
  unfold server_exactly;
  with stack_bytes sz. _;
  
  let current_sz = !srv.size;
  let val1 = srv.stack.(SZ.sub current_sz 2sz);
  let val2 = srv.stack.(SZ.sub current_sz 1sz);
  
  // Precondition ensures val2 != 0 via step_log_div_pre
  let result = U32.div val1 val2;
  
  srv.stack.(SZ.sub current_sz 2sz) <- result;
  srv.size := SZ.sub current_sz 1sz;
  
  resp_buf.(0sz) <- 0uy;  // Ok
  resp_buf.(1sz) <- 0uy;
  resp_buf.(2sz) <- 0uy;
  resp_buf.(3sz) <- 0uy;
  resp_buf.(4sz) <- 0uy;
  
  with resp_bytes1. _;
  
  lemma_step_log_div_consistent 'req_bytes resp_bytes1 log0;
  lemma_step_log_div_evolves 'req_bytes resp_bytes1 log0;
  
  MR.update #_ #log_evolves srv.ghost_log 
    (step_log_div 'req_bytes resp_bytes1 log0);
  
  with new_stack_bytes. rewrite (Arr.pts_to srv.stack new_stack_bytes)
                         as (Arr.pts_to srv.stack new_stack_bytes);
  with new_sz. rewrite (R.pts_to srv.size new_sz) as (R.pts_to srv.size new_sz);
  
  fold (server_exactly srv (step_log_div 'req_bytes resp_bytes1 log0));
  ()
}
#pop-options

(** General Request Dispatcher **)

// Helper to check if binary operation can execute
fn can_execute_binary_op (srv: server_state) (#log0: erased calc_log)
  requires server_exactly srv log0
  returns b: bool
  ensures server_exactly srv log0 ** pure (b == (L.length log0.current_state >= 2))
{
  unfold (server_exactly srv log0);
  with _stack _sz. _;
  let sz = !srv.size;
  fold (server_exactly srv log0);
  SZ.gte sz 2sz
}

#push-options "--fuel 0 --ifuel 1 --z3rlimit 80"
fn process_request
  (srv: server_state)
  (req_buf: array U8.t)
  (resp_buf: array U8.t)
  (#log0: erased calc_log)
  (#req_bytes: erased bytes{Seq.length req_bytes == 5})
  requires
    server_exactly srv log0 **
    Arr.pts_to req_buf req_bytes **
    Arr.pts_to resp_buf _
  requires with_pure (
    log_consistent log0 /\
    Seq.length req_bytes == 5
  )
  ensures exists* (resp_bytes1: bytes{Seq.length resp_bytes1 == 5}) (log1: calc_log).
          server_exactly srv log1 **
          Arr.pts_to req_buf req_bytes **
          Arr.pts_to resp_buf resp_bytes1 **
          pure (log_single_step log0 log1 /\ log_consistent log1)
{
  let tag = Arr.op_Array_Access req_buf 0sz;
  
  // Tag 0 = Push
  if U8.eq tag 0uy {
    let b1 = Arr.op_Array_Access req_buf 1sz;
    let b2 = Arr.op_Array_Access req_buf 2sz;
    let b3 = Arr.op_Array_Access req_buf 3sz;
    let b4 = Arr.op_Array_Access req_buf 4sz;
    
    let v0 : U32.t = U32.uint_to_t (U8.v b1);
    let v1 : U32.t = U32.uint_to_t (U8.v b2);
    let v2 : U32.t = U32.uint_to_t (U8.v b3);
    let v3 : U32.t = U32.uint_to_t (U8.v b4);
    
    let v01 = U32.mul v0 16777216ul;
    let v12 = U32.mul v1 65536ul;
    let v23 = U32.mul v2 256ul;
    
    let tmp = U32.add v01 v12;
    let tmp2 = U32.add tmp v23;
    let value = U32.add tmp2 v3;
    
    unfold (server_exactly srv log0);
    with _stack_bytes _sz _log_ref. _;
    let sz = !srv.size;
    fold (server_exactly srv log0);
    
    if SZ.lt sz 10sz {
      process_push srv req_buf resp_buf value #log0 #req_bytes
    } else {
      write_error_response resp_buf
    }
  } else if U8.eq tag 1uy {
    // Tag 1 = Peek
    unfold (server_exactly srv log0);
    with _stack_bytes _sz _log_ref. _;
    let sz = !srv.size;
    fold (server_exactly srv log0);
    
    if SZ.gt sz 0sz {
      process_peek srv req_buf resp_buf #log0 #req_bytes
    } else {
      write_error_response resp_buf
    }
  } else if U8.eq tag 2uy {
    // Tag 2 = Add
    let ok = can_execute_binary_op srv #log0;
    if ok {
      process_add srv req_buf resp_buf #log0 #req_bytes
    } else {
      write_error_response resp_buf
    }
  } else if U8.eq tag 3uy {
    // Tag 3 = Sub
    let ok = can_execute_binary_op srv #log0;
    if ok {
      process_sub srv req_buf resp_buf #log0 #req_bytes
    } else {
      write_error_response resp_buf
    }
  } else if U8.eq tag 4uy {
    // Tag 4 = Mul
    let ok = can_execute_binary_op srv #log0;
    if ok {
      process_mul srv req_buf resp_buf #log0 #req_bytes
    } else {
      write_error_response resp_buf
    }
  } else if U8.eq tag 5uy {
    // Tag 5 = Div
    let ok = can_execute_binary_op srv #log0;
    if ok {
      process_div srv req_buf resp_buf #log0 #req_bytes
    } else {
      write_error_response resp_buf
    }
  } else {
    // Invalid tag
    write_error_response resp_buf
  };
  ()
}
#pop-options
