  lemma_synth_extensionType_inv ();
  PPC.accessor_ext
    (PPC.accessor_compose
      (PPS.accessor_dsum_tag extensionCertificate_sum extensionType_repr_jumper parse_extensionCertificate_cases extensionCertificate_extension_data_default_parser ())
      (PPC.accessor_synth_fwd synth_extensionType synth_extensionType_inv)
      ()
    )
    extensionCertificate_clens_tag
    ()

