let extensionCertificate_write_conv_eq (m: extensionCertificate_mid)
  : Lemma (extensionCertificate_conv m == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag (extensionCertificate_gf m))
  = match m with
  | Extension_data_key_share_mid cm -> assert (extensionCertificate_conv (Extension_data_key_share_mid cm) == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag (extensionCertificate_gf (Extension_data_key_share_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Extension_data_supported_versions_mid cm -> assert (extensionCertificate_conv (Extension_data_supported_versions_mid cm) == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag (extensionCertificate_gf (Extension_data_supported_versions_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Extension_data_application_layer_protocol_negotiation_mid cm -> assert (extensionCertificate_conv (Extension_data_application_layer_protocol_negotiation_mid cm) == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag (extensionCertificate_gf (Extension_data_application_layer_protocol_negotiation_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Extension_data_signature_algorithms_mid cm -> assert (extensionCertificate_conv (Extension_data_signature_algorithms_mid cm) == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag (extensionCertificate_gf (Extension_data_signature_algorithms_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Extension_data_supported_groups_mid cm -> assert (extensionCertificate_conv (Extension_data_supported_groups_mid cm) == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag (extensionCertificate_gf (Extension_data_supported_groups_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Extension_data_server_name_mid cm -> assert (extensionCertificate_conv (Extension_data_server_name_mid cm) == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag (extensionCertificate_gf (Extension_data_server_name_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Extension_data_Unknown_extensionType_mid rv cm -> assert (extensionCertificate_conv (Extension_data_Unknown_extensionType_mid rv cm) == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag (extensionCertificate_gf (Extension_data_Unknown_extensionType_mid rv cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())

let extensionCertificate_write_coerce_eq ()
  : Lemma (
      (forall (x: extensionCertificate_low) (m2: extensionCertificate_mid) . extensionCertificate_vmatch x m2 == PPS.vmatch_dsum extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch x (extensionCertificate_gf m2)) /\
      (forall (m2: extensionCertificate_mid) . extensionCertificate_conv m2 == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag (extensionCertificate_gf m2))
    )
  = FStar.Classical.forall_intro_2 extensionCertificate_free_vmatch_eq;
    FStar.Classical.forall_intro extensionCertificate_write_conv_eq

let write_extensionCertificate : PPB.l2r_safe_writer extensionCertificate_vmatch extensionCertificate_serializer extensionCertificate_conv =
  PPB.l2r_safe_writer_coerce_mid write_extensionCertificate_sum extensionCertificate_vmatch extensionCertificate_conv extensionCertificate_gf (extensionCertificate_write_coerce_eq ())

