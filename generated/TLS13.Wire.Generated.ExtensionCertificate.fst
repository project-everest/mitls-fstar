let write_extensionCertificate_cases (k: LP.dsum_key extensionCertificate_sum)
  : PPS.l2r_safe_writer_dsum_payload_t extensionCertificate_sum parse_extensionCertificate_cases serialize_extensionCertificate_cases extensionCertificate_extension_data_default_parser extensionCertificate_extension_data_default_serializer extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch extensionCertificate_conv_of_tag k =
  match k with
  | LP.Known kk -> (match kk with
    | Key_share -> PPS.l2r_safe_writer_dsum_case extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch extensionCertificate_conv_of_tag (LP.Known Key_share)
        write_extensionCertificate_extension_data_default (fun xl -> match xl with | Extension_data_key_share_low v -> Some v | _ -> None) ()
    | Supported_versions -> PPS.l2r_safe_writer_dsum_case extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch extensionCertificate_conv_of_tag (LP.Known Supported_versions)
        write_extensionCertificate_extension_data_default (fun xl -> match xl with | Extension_data_supported_versions_low v -> Some v | _ -> None) ()
    | Application_layer_protocol_negotiation -> PPS.l2r_safe_writer_dsum_case extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch extensionCertificate_conv_of_tag (LP.Known Application_layer_protocol_negotiation)
        write_extensionCertificate_extension_data_default (fun xl -> match xl with | Extension_data_application_layer_protocol_negotiation_low v -> Some v | _ -> None) ()
    | Signature_algorithms -> PPS.l2r_safe_writer_dsum_case extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch extensionCertificate_conv_of_tag (LP.Known Signature_algorithms)
        write_extensionCertificate_extension_data_default (fun xl -> match xl with | Extension_data_signature_algorithms_low v -> Some v | _ -> None) ()
    | Supported_groups -> PPS.l2r_safe_writer_dsum_case extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch extensionCertificate_conv_of_tag (LP.Known Supported_groups)
        write_extensionCertificate_extension_data_default (fun xl -> match xl with | Extension_data_supported_groups_low v -> Some v | _ -> None) ()
    | Server_name -> PPS.l2r_safe_writer_dsum_case extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch extensionCertificate_conv_of_tag (LP.Known Server_name)
        write_extensionCertificate_extension_data_default (fun xl -> match xl with | Extension_data_server_name_low v -> Some v | _ -> None) ()
    )
  | LP.Unknown r -> PPS.l2r_safe_writer_dsum_case extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch extensionCertificate_conv_of_tag (LP.Unknown r)
      write_extensionCertificate_extension_data_default (fun xl -> match xl with | Extension_data_Unknown_extensionType_low _ v -> Some v | _ -> None) ()

