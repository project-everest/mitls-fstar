let extensionCertificate_coerce_conv_eq (m1: PPS.dsum_mid extensionCertificate_sum extensionCertificate_mid_of_tag)
  : Lemma (extensionCertificate_conv (extensionCertificate_fg m1) == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag m1)
  = match m1 with
  | (| k, cm |) ->
    (match k with
     | LP.Known kk -> (match kk with
       | Key_share -> assert (extensionCertificate_conv (extensionCertificate_fg (| LP.Known Key_share, cm |)) == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag (| LP.Known Key_share, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
       | Supported_versions -> assert (extensionCertificate_conv (extensionCertificate_fg (| LP.Known Supported_versions, cm |)) == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag (| LP.Known Supported_versions, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
       | Application_layer_protocol_negotiation -> assert (extensionCertificate_conv (extensionCertificate_fg (| LP.Known Application_layer_protocol_negotiation, cm |)) == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag (| LP.Known Application_layer_protocol_negotiation, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
       | Signature_algorithms -> assert (extensionCertificate_conv (extensionCertificate_fg (| LP.Known Signature_algorithms, cm |)) == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag (| LP.Known Signature_algorithms, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
       | Supported_groups -> assert (extensionCertificate_conv (extensionCertificate_fg (| LP.Known Supported_groups, cm |)) == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag (| LP.Known Supported_groups, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
       | Server_name -> assert (extensionCertificate_conv (extensionCertificate_fg (| LP.Known Server_name, cm |)) == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag (| LP.Known Server_name, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
       )
     | LP.Unknown r -> assert (extensionCertificate_conv (extensionCertificate_fg (| LP.Unknown r, cm |)) == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag (| LP.Unknown r, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
    )

let extensionCertificate_coerce_eq ()
  : Lemma (
      (forall (xl: extensionCertificate_low) (m1: PPS.dsum_mid extensionCertificate_sum extensionCertificate_mid_of_tag) .
        PPS.vmatch_dsum extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch xl m1 == extensionCertificate_vmatch xl (extensionCertificate_fg m1)) /\
      (forall (m1: PPS.dsum_mid extensionCertificate_sum extensionCertificate_mid_of_tag) .
        extensionCertificate_conv (extensionCertificate_fg m1) == PPS.dsum_conv extensionCertificate_sum extensionCertificate_mid_of_tag extensionCertificate_conv_of_tag m1)
    )
  = FStar.Classical.forall_intro_2 extensionCertificate_coerce_vmatch_eq;
    FStar.Classical.forall_intro extensionCertificate_coerce_conv_eq

let read_extensionCertificate : PPB.copyful_parse extensionCertificate_vmatch extensionCertificate_parser extensionCertificate_conv =
  PPB.copyful_parse_coerce_mid read_extensionCertificate_sum extensionCertificate_vmatch extensionCertificate_conv extensionCertificate_fg (extensionCertificate_coerce_eq ())

inline_for_extraction
let free_extensionCertificate_cases (k: LP.dsum_key extensionCertificate_sum)
  : PPB.free_t (extensionCertificate_casevmatch k) =
  match k with
  | LP.Known kk -> (match kk with
    | Key_share -> PPS.free_dsum_case extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch (LP.Known Key_share)
        free_extensionCertificate_extension_data_default (fun xl -> match xl with | Extension_data_key_share_low v -> Some v | _ -> None) ()
    | Supported_versions -> PPS.free_dsum_case extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch (LP.Known Supported_versions)
        free_extensionCertificate_extension_data_default (fun xl -> match xl with | Extension_data_supported_versions_low v -> Some v | _ -> None) ()
    | Application_layer_protocol_negotiation -> PPS.free_dsum_case extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch (LP.Known Application_layer_protocol_negotiation)
        free_extensionCertificate_extension_data_default (fun xl -> match xl with | Extension_data_application_layer_protocol_negotiation_low v -> Some v | _ -> None) ()
    | Signature_algorithms -> PPS.free_dsum_case extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch (LP.Known Signature_algorithms)
        free_extensionCertificate_extension_data_default (fun xl -> match xl with | Extension_data_signature_algorithms_low v -> Some v | _ -> None) ()
    | Supported_groups -> PPS.free_dsum_case extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch (LP.Known Supported_groups)
        free_extensionCertificate_extension_data_default (fun xl -> match xl with | Extension_data_supported_groups_low v -> Some v | _ -> None) ()
    | Server_name -> PPS.free_dsum_case extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch (LP.Known Server_name)
        free_extensionCertificate_extension_data_default (fun xl -> match xl with | Extension_data_server_name_low v -> Some v | _ -> None) ()
    )
  | LP.Unknown r -> PPS.free_dsum_case extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch (LP.Unknown r)
      free_extensionCertificate_extension_data_default (fun xl -> match xl with | Extension_data_Unknown_extensionType_low _ v -> Some v | _ -> None) ()

let free_extensionCertificate_sum : PPB.free_t (PPS.vmatch_dsum extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch) =
  PPS.free_dsum extensionCertificate_sum extensionCertificate_low extensionCertificate_tag_of_low extensionCertificate_mid_of_tag extensionCertificate_casevmatch free_extensionCertificate_cases (_ by (LP.dep_maybe_enum_destr_t_tac ()))

