  (let ln = FStar.Seq.length (LP.serialize (LP.serialize_maybe_enum_key _ extensionType_repr_serializer (LP.dsum_enum extensionCertificate_sum)) tg) in assert (2 <= ln /\ ln <= 2));
  (extensionCertificate_extension_data_default_bytesize_eq (x))

