let handshake_bytesize_eqn_certificate x =
    assert_norm (LP.parse_sum_kind (LP.get_parser_kind handshakeType_repr_parser) handshake_sum parse_handshake_cases == handshake_parser_kind);

  LP.serialize_sum_eq handshake_sum handshakeType_repr_serializer serialize_handshake_cases (Body_certificate x);
