       | Body_encrypted_extensions_low vp -> assert (PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_encrypted_extensions_low vp) (| New_session_ticket, cm |) == handshake_vmatch (Body_encrypted_extensions_low vp) (handshake_fg (| New_session_ticket, cm |))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
       | Body_certificate_low vp -> assert (PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_certificate_low vp) (| New_session_ticket, cm |) == handshake_vmatch (Body_certificate_low vp) (handshake_fg (| New_session_ticket, cm |))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
       | Body_certificate_verify_low vp -> assert (PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_certificate_verify_low vp) (| New_session_ticket, cm |) == handshake_vmatch (Body_certificate_verify_low vp) (handshake_fg (| New_session_ticket, cm |))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
       | Body_finished_low vp -> assert (PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_finished_low vp) (| New_session_ticket, cm |) == handshake_vmatch (Body_finished_low vp) (handshake_fg (| New_session_ticket, cm |))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
       | Body_key_update_low vp -> assert (PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_key_update_low vp) (| New_session_ticket, cm |) == handshake_vmatch (Body_key_update_low vp) (handshake_fg (| New_session_ticket, cm |))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
       | Body_new_session_ticket_low vp -> assert (PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_new_session_ticket_low vp) (| New_session_ticket, cm |) == handshake_vmatch (Body_new_session_ticket_low vp) (handshake_fg (| New_session_ticket, cm |))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
      )
    )

let handshake_coerce_conv_eq (m1: PPS.sum_mid handshake_sum handshake_mid_of_tag)
  : Lemma (handshake_conv (handshake_fg m1) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag m1)
  = match m1 with
  | (| k, cm |) ->
    (match k with
     | Client_hello -> assert (handshake_conv (handshake_fg (| Client_hello, cm |)) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (| Client_hello, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
     | Server_hello -> assert (handshake_conv (handshake_fg (| Server_hello, cm |)) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (| Server_hello, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
     | Encrypted_extensions -> assert (handshake_conv (handshake_fg (| Encrypted_extensions, cm |)) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (| Encrypted_extensions, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
     | Certificate -> assert (handshake_conv (handshake_fg (| Certificate, cm |)) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (| Certificate, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
     | Certificate_verify -> assert (handshake_conv (handshake_fg (| Certificate_verify, cm |)) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (| Certificate_verify, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
     | Finished -> assert (handshake_conv (handshake_fg (| Finished, cm |)) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (| Finished, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
     | Key_update -> assert (handshake_conv (handshake_fg (| Key_update, cm |)) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (| Key_update, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
     | New_session_ticket -> assert (handshake_conv (handshake_fg (| New_session_ticket, cm |)) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (| New_session_ticket, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
    )

let handshake_coerce_eq ()
  : Lemma (
      (forall (xl: handshake_low) (m1: PPS.sum_mid handshake_sum handshake_mid_of_tag) .
        PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch xl m1 == handshake_vmatch xl (handshake_fg m1)) /\
      (forall (m1: PPS.sum_mid handshake_sum handshake_mid_of_tag) .
        handshake_conv (handshake_fg m1) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag m1)
    )
  = FStar.Classical.forall_intro_2 handshake_coerce_vmatch_eq;
    FStar.Classical.forall_intro handshake_coerce_conv_eq

let read_handshake : PPB.copyful_parse handshake_vmatch handshake_parser handshake_conv =
  PPB.copyful_parse_coerce_mid read_handshake_sum handshake_vmatch handshake_conv handshake_fg (handshake_coerce_eq ())

inline_for_extraction
let free_handshake_cases (k: LP.sum_key handshake_sum)
  : PPB.free_t (handshake_casevmatch k) =
  match k with
  | Client_hello -> PPS.free_sum_case handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch Client_hello
      free_handshake_body_client_hello (fun xl -> match xl with | Body_client_hello_low v -> Some v | _ -> None) ()
  | Server_hello -> PPS.free_sum_case handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch Server_hello
      free_handshake_body_server_hello (fun xl -> match xl with | Body_server_hello_low v -> Some v | _ -> None) ()
  | Encrypted_extensions -> PPS.free_sum_case handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch Encrypted_extensions
      free_handshake_body_encrypted_extensions (fun xl -> match xl with | Body_encrypted_extensions_low v -> Some v | _ -> None) ()
  | Certificate -> PPS.free_sum_case handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch Certificate
      free_handshake_body_certificate (fun xl -> match xl with | Body_certificate_low v -> Some v | _ -> None) ()
  | Certificate_verify -> PPS.free_sum_case handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch Certificate_verify
      free_handshake_body_certificate_verify (fun xl -> match xl with | Body_certificate_verify_low v -> Some v | _ -> None) ()
  | Finished -> PPS.free_sum_case handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch Finished
      free_handshake_body_finished (fun xl -> match xl with | Body_finished_low v -> Some v | _ -> None) ()
  | Key_update -> PPS.free_sum_case handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch Key_update
      free_handshake_body_key_update (fun xl -> match xl with | Body_key_update_low v -> Some v | _ -> None) ()
  | New_session_ticket -> PPS.free_sum_case handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch New_session_ticket
      (PPB.free_leaf #(squash False)) (fun xl -> match xl with | Body_new_session_ticket_low v -> Some v | _ -> None) ()

let free_handshake_sum : PPB.free_t (PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch) =
  PPS.free_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch free_handshake_cases (_ by (LP.dep_enum_destr_tac ()))

let handshake_free_vmatch_eq (xl: handshake_low) (m: handshake_mid)
  : Lemma (handshake_vmatch xl m == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch xl (handshake_gf m))
  = match m with
  | Body_client_hello_mid cm -> (match xl with
    | Body_client_hello_low vp -> assert (handshake_vmatch (Body_client_hello_low vp) (Body_client_hello_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_client_hello_low vp) (handshake_gf (Body_client_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_server_hello_low vp -> assert (handshake_vmatch (Body_server_hello_low vp) (Body_client_hello_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_server_hello_low vp) (handshake_gf (Body_client_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_encrypted_extensions_low vp -> assert (handshake_vmatch (Body_encrypted_extensions_low vp) (Body_client_hello_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_encrypted_extensions_low vp) (handshake_gf (Body_client_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_certificate_low vp -> assert (handshake_vmatch (Body_certificate_low vp) (Body_client_hello_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_certificate_low vp) (handshake_gf (Body_client_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_certificate_verify_low vp -> assert (handshake_vmatch (Body_certificate_verify_low vp) (Body_client_hello_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_certificate_verify_low vp) (handshake_gf (Body_client_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_finished_low vp -> assert (handshake_vmatch (Body_finished_low vp) (Body_client_hello_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_finished_low vp) (handshake_gf (Body_client_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_key_update_low vp -> assert (handshake_vmatch (Body_key_update_low vp) (Body_client_hello_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_key_update_low vp) (handshake_gf (Body_client_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_new_session_ticket_low vp -> assert (handshake_vmatch (Body_new_session_ticket_low vp) (Body_client_hello_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_new_session_ticket_low vp) (handshake_gf (Body_client_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    )
  | Body_server_hello_mid cm -> (match xl with
    | Body_client_hello_low vp -> assert (handshake_vmatch (Body_client_hello_low vp) (Body_server_hello_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_client_hello_low vp) (handshake_gf (Body_server_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_server_hello_low vp -> assert (handshake_vmatch (Body_server_hello_low vp) (Body_server_hello_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_server_hello_low vp) (handshake_gf (Body_server_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_encrypted_extensions_low vp -> assert (handshake_vmatch (Body_encrypted_extensions_low vp) (Body_server_hello_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_encrypted_extensions_low vp) (handshake_gf (Body_server_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_certificate_low vp -> assert (handshake_vmatch (Body_certificate_low vp) (Body_server_hello_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_certificate_low vp) (handshake_gf (Body_server_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_certificate_verify_low vp -> assert (handshake_vmatch (Body_certificate_verify_low vp) (Body_server_hello_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_certificate_verify_low vp) (handshake_gf (Body_server_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_finished_low vp -> assert (handshake_vmatch (Body_finished_low vp) (Body_server_hello_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_finished_low vp) (handshake_gf (Body_server_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_key_update_low vp -> assert (handshake_vmatch (Body_key_update_low vp) (Body_server_hello_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_key_update_low vp) (handshake_gf (Body_server_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_new_session_ticket_low vp -> assert (handshake_vmatch (Body_new_session_ticket_low vp) (Body_server_hello_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_new_session_ticket_low vp) (handshake_gf (Body_server_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    )
  | Body_encrypted_extensions_mid cm -> (match xl with
    | Body_client_hello_low vp -> assert (handshake_vmatch (Body_client_hello_low vp) (Body_encrypted_extensions_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_client_hello_low vp) (handshake_gf (Body_encrypted_extensions_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_server_hello_low vp -> assert (handshake_vmatch (Body_server_hello_low vp) (Body_encrypted_extensions_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_server_hello_low vp) (handshake_gf (Body_encrypted_extensions_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_encrypted_extensions_low vp -> assert (handshake_vmatch (Body_encrypted_extensions_low vp) (Body_encrypted_extensions_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_encrypted_extensions_low vp) (handshake_gf (Body_encrypted_extensions_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_certificate_low vp -> assert (handshake_vmatch (Body_certificate_low vp) (Body_encrypted_extensions_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_certificate_low vp) (handshake_gf (Body_encrypted_extensions_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_certificate_verify_low vp -> assert (handshake_vmatch (Body_certificate_verify_low vp) (Body_encrypted_extensions_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_certificate_verify_low vp) (handshake_gf (Body_encrypted_extensions_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_finished_low vp -> assert (handshake_vmatch (Body_finished_low vp) (Body_encrypted_extensions_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_finished_low vp) (handshake_gf (Body_encrypted_extensions_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
    | Body_key_update_low vp -> assert (handshake_vmatch (Body_key_update_low vp) (Body_encrypted_extensions_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_key_update_low vp) (handshake_gf (Body_encrypted_extensions_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
