let free_handshake : PPB.free_t handshake_vmatch =
  PPB.free_coerce_mid free_handshake_sum handshake_vmatch handshake_gf (FStar.Classical.forall_intro_2 handshake_free_vmatch_eq)

inline_for_extraction
let write_handshake_cases (k: LP.sum_key handshake_sum)
  : PPS.l2r_safe_writer_sum_payload_t handshake_sum parse_handshake_cases serialize_handshake_cases handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch handshake_conv_of_tag k =
  match k with
  | Client_hello -> PPS.l2r_safe_writer_sum_case handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch handshake_conv_of_tag Client_hello
      write_handshake_body_client_hello (fun xl -> match xl with | Body_client_hello_low v -> Some v | _ -> None) ()
  | Server_hello -> PPS.l2r_safe_writer_sum_case handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch handshake_conv_of_tag Server_hello
      write_handshake_body_server_hello (fun xl -> match xl with | Body_server_hello_low v -> Some v | _ -> None) ()
  | Encrypted_extensions -> PPS.l2r_safe_writer_sum_case handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch handshake_conv_of_tag Encrypted_extensions
      write_handshake_body_encrypted_extensions (fun xl -> match xl with | Body_encrypted_extensions_low v -> Some v | _ -> None) ()
  | Certificate -> PPS.l2r_safe_writer_sum_case handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch handshake_conv_of_tag Certificate
      write_handshake_body_certificate (fun xl -> match xl with | Body_certificate_low v -> Some v | _ -> None) ()
  | Certificate_verify -> PPS.l2r_safe_writer_sum_case handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch handshake_conv_of_tag Certificate_verify
      write_handshake_body_certificate_verify (fun xl -> match xl with | Body_certificate_verify_low v -> Some v | _ -> None) ()
  | Finished -> PPS.l2r_safe_writer_sum_case handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch handshake_conv_of_tag Finished
      write_handshake_body_finished (fun xl -> match xl with | Body_finished_low v -> Some v | _ -> None) ()
  | Key_update -> PPS.l2r_safe_writer_sum_case handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch handshake_conv_of_tag Key_update
      write_handshake_body_key_update (fun xl -> match xl with | Body_key_update_low v -> Some v | _ -> None) ()
  | New_session_ticket -> PPS.l2r_safe_writer_sum_case handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch handshake_conv_of_tag New_session_ticket
      (PPS.l2r_safe_writer_false (LPS.eq_as_slprop (squash False)) LP.serialize_false) (fun xl -> match xl with | Body_new_session_ticket_low v -> Some v | _ -> None) ()

let write_handshake_sum
  : PPB.l2r_safe_writer (PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch) (LP.serialize_sum handshake_sum handshakeType_repr_serializer serialize_handshake_cases) (PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag) =
  PPS.l2r_safe_writer_sum handshake_sum handshakeType_repr_serializer write_handshakeType_key 1sz parse_handshake_cases serialize_handshake_cases
    handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch handshake_conv_of_tag write_handshake_cases (_ by (LP.dep_enum_destr_tac ())) ()

let handshake_write_conv_eq (m: handshake_mid)
  : Lemma (handshake_conv m == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (handshake_gf m))
  = match m with
  | Body_client_hello_mid cm -> assert (handshake_conv (Body_client_hello_mid cm) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (handshake_gf (Body_client_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Body_server_hello_mid cm -> assert (handshake_conv (Body_server_hello_mid cm) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (handshake_gf (Body_server_hello_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Body_encrypted_extensions_mid cm -> assert (handshake_conv (Body_encrypted_extensions_mid cm) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (handshake_gf (Body_encrypted_extensions_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Body_certificate_mid cm -> assert (handshake_conv (Body_certificate_mid cm) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (handshake_gf (Body_certificate_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Body_certificate_verify_mid cm -> assert (handshake_conv (Body_certificate_verify_mid cm) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (handshake_gf (Body_certificate_verify_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Body_finished_mid cm -> assert (handshake_conv (Body_finished_mid cm) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (handshake_gf (Body_finished_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Body_key_update_mid cm -> assert (handshake_conv (Body_key_update_mid cm) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (handshake_gf (Body_key_update_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Body_new_session_ticket_mid cm -> assert (handshake_conv (Body_new_session_ticket_mid cm) == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (handshake_gf (Body_new_session_ticket_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())

let handshake_write_coerce_eq ()
  : Lemma (
      (forall (x: handshake_low) (m2: handshake_mid) . handshake_vmatch x m2 == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch x (handshake_gf m2)) /\
      (forall (m2: handshake_mid) . handshake_conv m2 == PPS.sum_conv handshake_sum handshake_mid_of_tag handshake_conv_of_tag (handshake_gf m2))
    )
  = FStar.Classical.forall_intro_2 handshake_free_vmatch_eq;
    FStar.Classical.forall_intro handshake_write_conv_eq

let write_handshake : PPB.l2r_safe_writer handshake_vmatch handshake_serializer handshake_conv =
  PPB.l2r_safe_writer_coerce_mid write_handshake_sum handshake_vmatch handshake_conv handshake_gf (handshake_write_coerce_eq ())

let handshake_accessor_tag : PPB.accessor handshake_parser handshakeType_parser handshake_clens_tag =
  assert_norm (LP.parse_sum_kind (LP.get_parser_kind handshakeType_repr_parser) handshake_sum parse_handshake_cases == handshake_parser_kind);
  lemma_synth_handshakeType_inj ();
  lemma_synth_handshakeType_inv ();
  PPC.accessor_ext
    (PPC.accessor_compose
      (PPS.accessor_sum_tag handshake_sum handshakeType_repr_jumper parse_handshake_cases ())
      (PPC.accessor_synth_fwd synth_handshakeType synth_handshakeType_inv)
      ()
    )
    handshake_clens_tag
    ()

let handshake_bytesize_eqn_client_hello x =
    assert_norm (LP.parse_sum_kind (LP.get_parser_kind handshakeType_repr_parser) handshake_sum parse_handshake_cases == handshake_parser_kind);

  LP.serialize_sum_eq handshake_sum handshakeType_repr_serializer serialize_handshake_cases (Body_client_hello x);
  (let ln = FStar.Seq.length (LP.serialize (LP.serialize_enum_key _ handshakeType_repr_serializer (LP.sum_enum handshake_sum)) (key_of_handshake (Body_client_hello x))) in assert (1 <= ln /\ ln <= 1));
  (handshake_body_client_hello_bytesize_eq (x))

let handshake_bytesize_eqn_server_hello x =
    assert_norm (LP.parse_sum_kind (LP.get_parser_kind handshakeType_repr_parser) handshake_sum parse_handshake_cases == handshake_parser_kind);

  LP.serialize_sum_eq handshake_sum handshakeType_repr_serializer serialize_handshake_cases (Body_server_hello x);
