    | Body_key_update_low vp -> assert (handshake_vmatch (Body_key_update_low vp) (Body_certificate_mid cm) == PPS.vmatch_sum handshake_sum handshake_low handshake_tag_of_low handshake_mid_of_tag handshake_casevmatch (Body_key_update_low vp) (handshake_gf (Body_certificate_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops]; FStar.Tactics.trefl ())
