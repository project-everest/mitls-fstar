let ymodem_message_coerce_conv_eq (m1: PPS.sum_mid ymodem_message_sum ymodem_message_mid_of_tag)
  : Lemma (ymodem_message_conv (ymodem_message_fg m1) == PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag m1)
  = match m1 with
  | (| k, cm |) ->
    (match k with
     | Soh -> assert (ymodem_message_conv (ymodem_message_fg (| Soh, cm |)) == PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag (| Soh, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
     | Eot -> assert (ymodem_message_conv (ymodem_message_fg (| Eot, cm |)) == PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag (| Eot, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
     | Ack -> assert (ymodem_message_conv (ymodem_message_fg (| Ack, cm |)) == PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag (| Ack, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
     | Nak -> assert (ymodem_message_conv (ymodem_message_fg (| Nak, cm |)) == PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag (| Nak, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
     | Can -> assert (ymodem_message_conv (ymodem_message_fg (| Can, cm |)) == PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag (| Can, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
     | Crc_c -> assert (ymodem_message_conv (ymodem_message_fg (| Crc_c, cm |)) == PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag (| Crc_c, cm |)) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
    )

let ymodem_message_coerce_eq ()
  : Lemma (
      (forall (xl: ymodem_message_low) (m1: PPS.sum_mid ymodem_message_sum ymodem_message_mid_of_tag) .
        PPS.vmatch_sum ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch xl m1 == ymodem_message_vmatch xl (ymodem_message_fg m1)) /\
      (forall (m1: PPS.sum_mid ymodem_message_sum ymodem_message_mid_of_tag) .
        ymodem_message_conv (ymodem_message_fg m1) == PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag m1)
    )
  = FStar.Classical.forall_intro_2 ymodem_message_coerce_vmatch_eq;
    FStar.Classical.forall_intro ymodem_message_coerce_conv_eq

let read_ymodem_message : PPB.copyful_parse ymodem_message_vmatch ymodem_message_parser ymodem_message_conv =
  PPB.copyful_parse_coerce_mid read_ymodem_message_sum ymodem_message_vmatch ymodem_message_conv ymodem_message_fg (ymodem_message_coerce_eq ())

inline_for_extraction
let free_ymodem_message_cases (k: LP.sum_key ymodem_message_sum)
  : PPB.free_t (ymodem_message_casevmatch k) =
  match k with
  | Soh -> PPS.free_sum_case ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch Soh
      free_ymodem_soh_body (fun xl -> match xl with | Body_soh_low v -> Some v | _ -> None) ()
  | Eot -> PPS.free_sum_case ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch Eot
      free_ymodem_empty (fun xl -> match xl with | Body_eot_low v -> Some v | _ -> None) ()
  | Ack -> PPS.free_sum_case ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch Ack
      free_ymodem_empty (fun xl -> match xl with | Body_ack_low v -> Some v | _ -> None) ()
  | Nak -> PPS.free_sum_case ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch Nak
      free_ymodem_empty (fun xl -> match xl with | Body_nak_low v -> Some v | _ -> None) ()
  | Can -> PPS.free_sum_case ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch Can
      free_ymodem_empty (fun xl -> match xl with | Body_can_low v -> Some v | _ -> None) ()
  | Crc_c -> PPS.free_sum_case ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch Crc_c
      free_ymodem_empty (fun xl -> match xl with | Body_crc_c_low v -> Some v | _ -> None) ()

let free_ymodem_message_sum : PPB.free_t (PPS.vmatch_sum ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch) =
  PPS.free_sum ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch free_ymodem_message_cases (_ by (LP.dep_enum_destr_tac ()))

