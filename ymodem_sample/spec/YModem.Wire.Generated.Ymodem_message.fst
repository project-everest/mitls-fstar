let ymodem_message_bytesize_eqn_can x =
    assert_norm (LP.parse_sum_kind (LP.get_parser_kind ymodem_tag_repr_parser) ymodem_message_sum parse_ymodem_message_cases == ymodem_message_parser_kind);

  LP.serialize_sum_eq ymodem_message_sum ymodem_tag_repr_serializer serialize_ymodem_message_cases (Body_can x);
  (let ln = FStar.Seq.length (LP.serialize (LP.serialize_enum_key _ ymodem_tag_repr_serializer (LP.sum_enum ymodem_message_sum)) (key_of_ymodem_message (Body_can x))) in assert (1 <= ln /\ ln <= 1));
  (ymodem_empty_bytesize_eq (x))

let ymodem_message_bytesize_eqn_crc_c x =
    assert_norm (LP.parse_sum_kind (LP.get_parser_kind ymodem_tag_repr_parser) ymodem_message_sum parse_ymodem_message_cases == ymodem_message_parser_kind);

  LP.serialize_sum_eq ymodem_message_sum ymodem_tag_repr_serializer serialize_ymodem_message_cases (Body_crc_c x);
  (let ln = FStar.Seq.length (LP.serialize (LP.serialize_enum_key _ ymodem_tag_repr_serializer (LP.sum_enum ymodem_message_sum)) (key_of_ymodem_message (Body_crc_c x))) in assert (1 <= ln /\ ln <= 1));
  (ymodem_empty_bytesize_eq (x))

