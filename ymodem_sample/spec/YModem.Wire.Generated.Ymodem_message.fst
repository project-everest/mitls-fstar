let free_ymodem_message : PPB.free_t ymodem_message_vmatch =
  PPB.free_coerce_mid free_ymodem_message_sum ymodem_message_vmatch ymodem_message_gf (FStar.Classical.forall_intro_2 ymodem_message_free_vmatch_eq)

inline_for_extraction
let write_ymodem_message_cases (k: LP.sum_key ymodem_message_sum)
  : PPS.l2r_safe_writer_sum_payload_t ymodem_message_sum parse_ymodem_message_cases serialize_ymodem_message_cases ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch ymodem_message_conv_of_tag k =
  match k with
  | Soh -> PPS.l2r_safe_writer_sum_case ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch ymodem_message_conv_of_tag Soh
      write_ymodem_soh_body (fun xl -> match xl with | Body_soh_low v -> Some v | _ -> None) ()
  | Eot -> PPS.l2r_safe_writer_sum_case ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch ymodem_message_conv_of_tag Eot
      write_ymodem_empty (fun xl -> match xl with | Body_eot_low v -> Some v | _ -> None) ()
  | Ack -> PPS.l2r_safe_writer_sum_case ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch ymodem_message_conv_of_tag Ack
      write_ymodem_empty (fun xl -> match xl with | Body_ack_low v -> Some v | _ -> None) ()
  | Nak -> PPS.l2r_safe_writer_sum_case ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch ymodem_message_conv_of_tag Nak
      write_ymodem_empty (fun xl -> match xl with | Body_nak_low v -> Some v | _ -> None) ()
  | Can -> PPS.l2r_safe_writer_sum_case ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch ymodem_message_conv_of_tag Can
      write_ymodem_empty (fun xl -> match xl with | Body_can_low v -> Some v | _ -> None) ()
  | Crc_c -> PPS.l2r_safe_writer_sum_case ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch ymodem_message_conv_of_tag Crc_c
      write_ymodem_empty (fun xl -> match xl with | Body_crc_c_low v -> Some v | _ -> None) ()

let write_ymodem_message_sum
  : PPB.l2r_safe_writer (PPS.vmatch_sum ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch) (LP.serialize_sum ymodem_message_sum ymodem_tag_repr_serializer serialize_ymodem_message_cases) (PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag) =
  PPS.l2r_safe_writer_sum ymodem_message_sum ymodem_tag_repr_serializer write_ymodem_tag_key 1sz parse_ymodem_message_cases serialize_ymodem_message_cases
    ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch ymodem_message_conv_of_tag write_ymodem_message_cases (_ by (LP.dep_enum_destr_tac ())) ()

let ymodem_message_write_conv_eq (m: ymodem_message_mid)
  : Lemma (ymodem_message_conv m == PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag (ymodem_message_gf m))
  = match m with
  | Body_soh_mid cm -> assert (ymodem_message_conv (Body_soh_mid cm) == PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag (ymodem_message_gf (Body_soh_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Body_eot_mid cm -> assert (ymodem_message_conv (Body_eot_mid cm) == PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag (ymodem_message_gf (Body_eot_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Body_ack_mid cm -> assert (ymodem_message_conv (Body_ack_mid cm) == PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag (ymodem_message_gf (Body_ack_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Body_nak_mid cm -> assert (ymodem_message_conv (Body_nak_mid cm) == PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag (ymodem_message_gf (Body_nak_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Body_can_mid cm -> assert (ymodem_message_conv (Body_can_mid cm) == PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag (ymodem_message_gf (Body_can_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())
  | Body_crc_c_mid cm -> assert (ymodem_message_conv (Body_crc_c_mid cm) == PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag (ymodem_message_gf (Body_crc_c_mid cm))) by (FStar.Tactics.norm [delta; iota; zeta; primops; unascribe; nbe]; FStar.Tactics.trefl ())

let ymodem_message_write_coerce_eq ()
  : Lemma (
      (forall (x: ymodem_message_low) (m2: ymodem_message_mid) . ymodem_message_vmatch x m2 == PPS.vmatch_sum ymodem_message_sum ymodem_message_low ymodem_message_tag_of_low ymodem_message_mid_of_tag ymodem_message_casevmatch x (ymodem_message_gf m2)) /\
      (forall (m2: ymodem_message_mid) . ymodem_message_conv m2 == PPS.sum_conv ymodem_message_sum ymodem_message_mid_of_tag ymodem_message_conv_of_tag (ymodem_message_gf m2))
    )
  = FStar.Classical.forall_intro_2 ymodem_message_free_vmatch_eq;
    FStar.Classical.forall_intro ymodem_message_write_conv_eq

let write_ymodem_message : PPB.l2r_safe_writer ymodem_message_vmatch ymodem_message_serializer ymodem_message_conv =
  PPB.l2r_safe_writer_coerce_mid write_ymodem_message_sum ymodem_message_vmatch ymodem_message_conv ymodem_message_gf (ymodem_message_write_coerce_eq ())

let ymodem_message_accessor_tag : PPB.accessor ymodem_message_parser ymodem_tag_parser ymodem_message_clens_tag =
  assert_norm (LP.parse_sum_kind (LP.get_parser_kind ymodem_tag_repr_parser) ymodem_message_sum parse_ymodem_message_cases == ymodem_message_parser_kind);
  lemma_synth_ymodem_tag_inj ();
  lemma_synth_ymodem_tag_inv ();
  PPC.accessor_ext
    (PPC.accessor_compose
      (PPS.accessor_sum_tag ymodem_message_sum ymodem_tag_repr_jumper parse_ymodem_message_cases ())
      (PPC.accessor_synth_fwd synth_ymodem_tag synth_ymodem_tag_inv)
      ()
    )
    ymodem_message_clens_tag
    ()

let ymodem_message_bytesize_eqn_soh x =
    assert_norm (LP.parse_sum_kind (LP.get_parser_kind ymodem_tag_repr_parser) ymodem_message_sum parse_ymodem_message_cases == ymodem_message_parser_kind);

  LP.serialize_sum_eq ymodem_message_sum ymodem_tag_repr_serializer serialize_ymodem_message_cases (Body_soh x);
  (let ln = FStar.Seq.length (LP.serialize (LP.serialize_enum_key _ ymodem_tag_repr_serializer (LP.sum_enum ymodem_message_sum)) (key_of_ymodem_message (Body_soh x))) in assert (1 <= ln /\ ln <= 1));
  (ymodem_soh_body_bytesize_eq (x))

let ymodem_message_bytesize_eqn_eot x =
    assert_norm (LP.parse_sum_kind (LP.get_parser_kind ymodem_tag_repr_parser) ymodem_message_sum parse_ymodem_message_cases == ymodem_message_parser_kind);

  LP.serialize_sum_eq ymodem_message_sum ymodem_tag_repr_serializer serialize_ymodem_message_cases (Body_eot x);
  (let ln = FStar.Seq.length (LP.serialize (LP.serialize_enum_key _ ymodem_tag_repr_serializer (LP.sum_enum ymodem_message_sum)) (key_of_ymodem_message (Body_eot x))) in assert (1 <= ln /\ ln <= 1));
  (ymodem_empty_bytesize_eq (x))

