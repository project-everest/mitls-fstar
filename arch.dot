digraph TLS13Architecture {
  graph [
    rankdir=LR,
    compound=true,
    bgcolor="white",
    fontname="Helvetica",
    fontsize=18,
    labelloc=t,
    label="TLS 1.3 extracted client architecture and trusted boundaries",
    pad=0.35,
    nodesep=0.45,
    ranksep=0.75
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=10,
    margin="0.08,0.05",
    color="#777777",
    penwidth=1.3
  ];

  edge [
    fontname="Helvetica",
    fontsize=9,
    color="#555555",
    fontcolor="#333333",
    arrowsize=0.65,
    penwidth=1.1
  ];

  subgraph cluster_driver {
    label="External C driver / tests";
    color="#777777";
    fillcolor="#eeeeee";
    style="rounded,filled";

    Driver [label="network/application driver\nowns TCP reads/writes", fillcolor="#eeeeee"];
    BindingTest [label="test_connection_bindings.c\ndeterministic API test", fillcolor="#eeeeee"];
    OpenSSLEcho [label="test_extracted_client_openssl_echo.c\nlocal OpenSSL interop", fillcolor="#eeeeee"];
  }

  subgraph cluster_impl {
    label="Extracted Pulse/F* implementation";
    color="#2e8b57";
    fillcolor="#f4fbf4";
    style="rounded,filled";

    Client [label="TLS13.Impl.Client\npublic buffer/event API", fillcolor="#e8f7e8", color="#2e8b57"];
    ClientTypes [label="TLS13.Impl.Client.Types\nresponses, local actions, legality predicates", fillcolor="#e8f7e8", color="#2e8b57"];
    Mutations [label="ConnectionState.Fail/Network\nLocalHandshake/LocalAuth\nLocalSend/LocalApp\nstate mutations / transitions", fillcolor="#e8f7e8", color="#2e8b57"];
    Repr [label="TLS13.Impl.ConnectionState.Repr\nstorage + connection_exactly", fillcolor="#e8f7e8", color="#2e8b57"];
    Queries [label="TLS13.Impl.ConnectionState.Queries\nruntime checks + copyouts", fillcolor="#e8f7e8", color="#2e8b57"];
    Model [label="TLS13.Impl.ConnectionState.Model/Bounds/Tags\npure model helpers + proof predicates", fillcolor="#e8f7e8", color="#2e8b57"];
    Handlers [label="TLS13.Impl.Handle.*\nhandshake/local/alert/app dispatch", fillcolor="#e8f7e8", color="#2e8b57"];
    ImplMessages [label="TLS13.Impl.Messages\nextractable L messages + validity predicates", fillcolor="#e8f7e8", color="#2e8b57"];
    Parser [label="TLS13.Impl.Parser\nverified parser facade", fillcolor="#e8f7e8", color="#2e8b57"];
    Serializer [label="TLS13.Impl.Serializer\nverified serializer facade", fillcolor="#e8f7e8", color="#2e8b57"];
    KeySchedule [label="TLS13.KeySchedule\nTLS 1.3 secret derivation", fillcolor="#e8f7e8", color="#2e8b57"];
    Record [label="TLS13.Record\nrecord-state and AEAD wrapper", fillcolor="#e8f7e8", color="#2e8b57"];
  }

  subgraph cluster_tcb {
    label="Trusted implementation boundaries";
    color="#c9342c";
    fillcolor="#fff7f7";
    style="rounded,filled";

    CryptoABI [label="TLS13.Crypto.fsti\ncrypto ABI", fillcolor="#ffe8e8", color="#c9342c"];
    X509ABI [label="TLS13.X509.fsti\ncertificate/signature ABI", fillcolor="#ffe8e8", color="#c9342c"];
    MachineTypes [label="TLS13.MachineTypes.fsti\nmachine/runtime types", fillcolor="#ffe8e8", color="#c9342c"];
    CryptoC [label="tls13_crypto_external.c\nHACL glue", fillcolor="#ffe8e8", color="#c9342c"];
    X509C [label="tls13_openssl_stubs.c\nOpenSSL validation/signature checks", fillcolor="#ffe8e8", color="#c9342c"];
    PulseShims [label="tls13_pulse_shims.c\nextraction support", fillcolor="#ffe8e8", color="#c9342c"];
    HACL [label="HACL* C snapshot", fillcolor="#ffe8e8", color="#c9342c"];
    OpenSSL [label="OpenSSL library", fillcolor="#ffe8e8", color="#c9342c"];
    Runtime [label="KaRaMeL/Pulse/C runtime,\nallocator, compiler, libc", fillcolor="#eeeeee", color="#777777"];
  }

  subgraph cluster_spec {
    label="Pure F* model and logical assumptions";
    color="#4f7ccf";
    fillcolor="#f5f8ff";
    style="rounded,filled";

    Bytes [label="TLS13.Bytes", fillcolor="#e8f1ff", color="#4f7ccf"];
    Types [label="TLS13.Types", fillcolor="#e8f1ff", color="#4f7ccf"];
    Messages [label="TLS13.Messages", fillcolor="#e8f1ff", color="#4f7ccf"];
    WireSpec [label="TLS13.Wire.Spec\npure wire parse/serialize", fillcolor="#e8f1ff", color="#4f7ccf"];
    HandshakeSpec [label="TLS13.Handshake.Spec", fillcolor="#e8f1ff", color="#4f7ccf"];
    RecordSpec [label="TLS13.Record.Spec", fillcolor="#e8f1ff", color="#4f7ccf"];
    CryptoSpec [label="TLS13.Crypto.Spec.fsti", fillcolor="#fff4cc", color="#b8860b"];
    X509Spec [label="TLS13.X509.Spec.fsti", fillcolor="#fff4cc", color="#b8860b"];
    Transcript [label="TLS13.Transcript", fillcolor="#e8f1ff", color="#4f7ccf"];
    Keys [label="TLS13.Keys", fillcolor="#e8f1ff", color="#4f7ccf"];
    StateSpec [label="TLS13.Spec.ConnectionState\nrich client state + legal deltas", fillcolor="#e8f1ff", color="#4f7ccf"];
    ConnLog [label="TLS13.ConnectionLog\nraw/record/message/app-log vocabulary", fillcolor="#e8f1ff", color="#4f7ccf"];
  }

  Driver -> Client;
  BindingTest -> Client;
  OpenSSLEcho -> Client;

  Client -> ClientTypes;
  Client -> Mutations;
  Client -> Repr;
  Client -> Queries;
  Client -> Handlers;
  Handlers -> Mutations;
  Handlers -> Repr;
  Handlers -> Queries;
  Handlers -> Parser;
  Handlers -> Serializer;
  Handlers -> Record;
  Handlers -> KeySchedule;
  Mutations -> Repr;
  Mutations -> Queries;
  Mutations -> Model;
  Mutations -> ImplMessages;
  Repr -> Model;
  Queries -> Repr;
  Queries -> Model;
  Repr -> StateSpec [style=dashed, label="connection_exactly", color="#777777"];
  Mutations -> StateSpec [style=dashed, label="legal deltas", color="#777777"];
  ClientTypes -> StateSpec [style=dashed, label="legal responses", color="#777777"];

  Record -> CryptoABI;
  KeySchedule -> CryptoABI;
  Mutations -> X509ABI;
  Mutations -> MachineTypes;
  CryptoABI -> CryptoC;
  X509ABI -> X509C;
  CryptoC -> HACL;
  X509C -> OpenSSL;
  CryptoC -> PulseShims;
  PulseShims -> Runtime;

  ImplMessages -> Messages [style=dashed, label="L/M validity", color="#777777"];
  Parser -> WireSpec [style=dashed, label="postconditions", color="#777777"];
  Serializer -> WireSpec [style=dashed, label="postconditions", color="#777777"];
  Record -> RecordSpec [style=dashed, label="seal/open spec", color="#777777"];
  KeySchedule -> Keys [style=dashed, label="secret specs", color="#777777"];
  CryptoABI -> CryptoSpec [style=dashed, label="assumed behavior", color="#777777"];
  X509ABI -> X509Spec [style=dashed, label="assumed behavior", color="#777777"];
  StateSpec -> ConnLog;
  StateSpec -> Messages;
  StateSpec -> RecordSpec;
  StateSpec -> HandshakeSpec;
  StateSpec -> Transcript;
  StateSpec -> Keys;
  WireSpec -> Messages;
  WireSpec -> RecordSpec;
  WireSpec -> HandshakeSpec;
  Messages -> Types;
  Messages -> Bytes;
  RecordSpec -> CryptoSpec;
  HandshakeSpec -> X509Spec;
  ConnLog -> Messages;
  ConnLog -> Bytes;
}
