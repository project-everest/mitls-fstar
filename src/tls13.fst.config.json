{
  "fstar_exe": "../tools/everparse/opt/FStar/bin/fstar.exe",
  "options": [
    "--cache_checked_modules",
    "--cache_dir", "../_cache",
    "--odir", "../_output",
    "--warn_error", "-321",
    "--report_assumes", "warn",
    "--already_cached", "Prims,FStar,Pulse,PulseCore,C,Spec.Loops,LowParse -TLS13 +TLS13.Wire.Generated",
    "--ext", "optimize_let_vc",
    "--ext", "fly_deps",
    "--include", "spec/common",
    "--include", "spec/assumptions",
    "--include", "spec/core",
    "--include", "spec/properties",
    "--include", "impl",
    "--include", "../generated",
    "--include", "../tools/everparse/lib/everparse/lowparse"
  ],
  "include_dirs": [
    "spec/common",
    "spec/assumptions",
    "spec/core",
    "spec/properties",
    "impl",
    "../generated",
    "../tools/everparse/lib/everparse/lowparse"
  ]
}
