  "include_dirs": [
    "../third_party/dolev-yao-star-extrinsic/cache",
    "../third_party/dolev-yao-star-extrinsic/src/core",
    "../common",
    "spec/common",
    "spec/assumptions",
    "spec/core",
    "spec/properties",
    "spec/symbolic",
    "impl",
    "impl/extern",
